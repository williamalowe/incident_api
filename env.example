PORT=3000

# Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Clients must send this in the x-api-key header (leave blank to disable)
API_KEY=change-me

# Matching: same category + location within this many hours counts as similar
SIMILARITY_WINDOW_HOURS=24
SIMILARITY_LIMIT=10

# How close category and location must be (0-1). 1 = exact match only.
# All four values can be overridden per request on /check.
CATEGORY_MATCH_THRESHOLD=0.75
LOCATION_MATCH_THRESHOLD=0.6