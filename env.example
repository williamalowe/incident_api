PORT=3000

# Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Clients must send this in the x-api-key header (leave blank to disable)
API_KEY=change-me

# Similarity defaults (window, threshold and limit can be overridden per request on /check)
SIMILARITY_WINDOW_HOURS=24
SIMILARITY_THRESHOLD=0.5
SIMILARITY_LIMIT=5

# How much each field counts towards the combined score (should add up to 1)
WEIGHT_DESCRIPTION=0.6
WEIGHT_CATEGORY=0.2
WEIGHT_LOCATION=0.2